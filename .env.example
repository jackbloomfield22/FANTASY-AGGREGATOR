# ---------------------------------------------------------------------------
# Fantasy Aggregator — environment variables
# Everything here is OPTIONAL: with no configuration at all, the app runs in
# full demo mode and the Sleeper connection still works (public API, no key).
# ---------------------------------------------------------------------------

# --- Supabase (auth + persistence) -----------------------------------------
# Create a project at https://supabase.com, then run the SQL in
# supabase/migrations/ against it. Without these, auth pages offer demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed only for privileged jobs (e.g. maintaining the shared
# canonical player directory). Never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Live NFL data: Sportradar (production live provider) -------------------
# Server-only. When set, real NFL schedule/scores/stats replace the demo
# simulation for connected (non-demo) fantasy accounts.
SPORTRADAR_API_KEY=
# "trial" (default) or "production" — selects the Sportradar access level
# segment in the API URL.
SPORTRADAR_ACCESS_LEVEL=trial

# --- Yahoo Fantasy (OAuth) ---------------------------------------------------
# Server-only. Register an app at https://developer.yahoo.com/apps/ with the
# Fantasy Sports (read) scope. Without these, the Yahoo card shows as
# requiring configuration — no fake OAuth is presented.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
